# Copy to .env.local for local development. Never commit real values.
# Both values come from Supabase: Project Settings -> API.
# The anon key is designed to be public; your data is protected by Row Level Security (see supabase/schema.sql).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
